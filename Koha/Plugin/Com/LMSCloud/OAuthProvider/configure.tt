[% USE raw %]
[% USE Koha %]
[% TRY %]
    [% PROCESS "$PLUGIN_DIR/i18n/${LANG}.inc" %]
[% CATCH %]
    [% PROCESS "$PLUGIN_DIR/i18n/default.inc" %]
[% END %]
[% INCLUDE 'doc-head-open.inc' %]
<title>[% T.cfg_title | $raw %]</title>
[% INCLUDE 'doc-head-close.inc' %]

[%# Renders the claims configuration table + "add claim" modal. Existing
    entries (claims, an arrayref of {type, source, claim_name, value}) are
    rendered server-side as real rows; new rows added via the modal are
    built client-side in the same shape by the script at the bottom of this
    file. Only one of the edit/create forms is ever present on a page load,
    so this BLOCK is only ever PROCESSed once despite being usable by both. %]
[% BLOCK claims_config_widget %]
  <div class="oauthprovider-claims-widget"
       data-name-hint="[% T.cfg_claim_name_hint | html %]"
       data-duplicate-error="[% T.cfg_claim_duplicate_error | html %]"
       data-remove-label="[% T.cfg_claim_remove | html %]"
       data-static-label="[% T.cfg_claim_source_static | html %]">
    <table class="table oauthprovider-claims-table">
      <thead>
        <tr>
          <th>[% T.cfg_claim_source_th | $raw %]</th>
          <th>[% T.cfg_claim_name_th | $raw %]</th>
          <th>[% T.cfg_claim_value_th | $raw %]</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        [% FOREACH entry IN claims %]
          [% SET source_display = '' %]
          [% IF entry.type == 'field' %]
            [% SET label_key = 'claim_label_' _ entry.source %]
            [% SET source_display = T.$label_key %]
          [% ELSIF entry.type == 'attribute' %]
            [% FOREACH at IN attribute_types %]
              [% IF at.code == entry.source %][% SET source_display = at.description _ ' (' _ at.code _ ')' %][% END %]
            [% END %]
          [% ELSE %]
            [% SET source_display = T.cfg_claim_source_static %]
          [% END %]
          <tr class="claim-row">
            <td class="claim-source-display">[% source_display | html %]</td>
            <td>
              <input type="hidden" name="claim_type" value="[% entry.type | html %]">
              <input type="hidden" name="claim_source" value="[% entry.source | html %]">
              <input type="text" name="claim_name" value="[% entry.claim_name | html %]" class="claim-name-input" required pattern="[A-Za-z_][A-Za-z0-9_]*">
            </td>
            <td>
              <input type="text" name="claim_value" value="[% entry.value | html %]" class="claim-value-input"
                [% UNLESS entry.type == 'static' %]style="visibility:hidden"[% END %]>
            </td>
            <td><button type="button" class="btn btn-default btn-xs claims-remove-row">[% T.cfg_claim_remove | $raw %]</button></td>
          </tr>
        [% END %]
      </tbody>
    </table>
    <button type="button" class="btn btn-default btn-sm claims-add-btn" data-toggle="modal" data-target="#oauthprovider-claim-modal">[% T.cfg_claim_add | $raw %]</button>
    <div class="claims-duplicate-error dialog alert" style="display:none;margin-top:.5em">[% T.cfg_claim_duplicate_error | $raw %]</div>
  </div>

  <select id="oauthprovider-field-catalog-template" style="display:none">
    [% FOREACH claim IN claims_catalog %]
      [% SET label_key = 'claim_label_' _ claim.key %]
      <option value="[% claim.key | html %]">[% T.$label_key | $raw %]</option>
    [% END %]
  </select>
  <select id="oauthprovider-attribute-catalog-template" style="display:none">
    [% FOREACH at IN attribute_types %]
      <option value="[% at.code | html %]">[% at.description | html %] ([% at.code | html %])</option>
    [% END %]
  </select>

  <div class="modal" id="oauthprovider-claim-modal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
          <h4 class="modal-title">[% T.cfg_claim_modal_title | $raw %]</h4>
        </div>
        <div class="modal-body">
          <fieldset class="rows">
            <ol>
              <li>
                <label for="oauthprovider-modal-type">[% T.cfg_claim_type_label | $raw %]</label>
                <select id="oauthprovider-modal-type">
                  <option value="field">[% T.cfg_claim_type_field | $raw %]</option>
                  <option value="attribute">[% T.cfg_claim_type_attribute | $raw %]</option>
                  <option value="static">[% T.cfg_claim_type_static | $raw %]</option>
                </select>
              </li>
              <li class="oauthprovider-modal-field-row">
                <label for="oauthprovider-modal-field-source">[% T.cfg_claim_source_label | $raw %]</label>
                <select id="oauthprovider-modal-field-source"></select>
              </li>
              <li class="oauthprovider-modal-attribute-row" style="display:none">
                <label for="oauthprovider-modal-attribute-source">[% T.cfg_claim_source_label | $raw %]</label>
                <select id="oauthprovider-modal-attribute-source"></select>
              </li>
              <li class="oauthprovider-modal-static-row" style="display:none">
                <label for="oauthprovider-modal-static-value">[% T.cfg_claim_value_label | $raw %]</label>
                <input type="text" id="oauthprovider-modal-static-value">
              </li>
              <li>
                <label for="oauthprovider-modal-claim-name">[% T.cfg_claim_name_label | $raw %]</label>
                <input type="text" id="oauthprovider-modal-claim-name" pattern="[A-Za-z_][A-Za-z0-9_]*">
                <div class="hint">[% T.cfg_claim_name_hint | $raw %]</div>
              </li>
            </ol>
          </fieldset>
          <div class="oauthprovider-modal-error dialog alert" style="display:none"></div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-default" data-dismiss="modal">[% T.cfg_cancel | $raw %]</button>
          <button type="button" class="btn btn-primary" id="oauthprovider-modal-confirm">[% T.cfg_claim_add | $raw %]</button>
        </div>
      </div>
    </div>
  </div>
[% END %]
<style>
    #plugins_oauthprovider_configure fieldset.rows label {
        width: 20rem;
    }
    #plugins_oauthprovider_configure fieldset.rows label.radio,
    #plugins_oauthprovider_configure fieldset.rows label.yesno,
    #plugins_oauthprovider_configure fieldset.rows label.inline,
    #plugins_oauthprovider_configure fieldset.rows label.error {
        width: auto;
    }
    #plugins_oauthprovider_configure fieldset.rows div.hint {
        margin-left: 21rem;
    }
</style>
</head>
<body id="plugins_oauthprovider_configure" class="plugins">
[% INCLUDE 'html_helpers.inc' %]
[% WRAPPER 'header.inc' %][% END %]

[% WRAPPER 'sub-header.inc' %]
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item %]
            <a href="/cgi-bin/koha/admin/admin-home.pl">Administration</a>
        [% END %]
        [% WRAPPER breadcrumb_item %]
            <a href="/cgi-bin/koha/plugins/plugins-home.pl">Plugins</a>
        [% END %]
        [% WRAPPER breadcrumb_item bc_active= 1 %]
            <span>[% T.cfg_title | $raw %]</span>
        [% END %]
    [% END #/ WRAPPER breadcrumbs %]
[% END #/ WRAPPER sub-header.inc %]


<div class="main container-fluid">
  <div class="row">
    <div id="col-content" class="col-sm-12">

      <h1>[% T.cfg_heading | $raw %]</h1>

      <p>[% T.cfg_intro | $raw %]</p>

      <h2>[% T.cfg_settings_heading | $raw %]</h2>
      <form method="post">
        <input type="hidden" name="class" value="[% plugin_class | html %]">
        <input type="hidden" name="method" value="configure">
        <input type="hidden" name="action" value="save_settings">
        <fieldset class="rows">
          <ol>
            <li>
              <label for="issuer_url">[% T.cfg_issuer_label | $raw %]</label>
              <input type="url" id="issuer_url" name="issuer_url" size="60"
                     value="[% settings.issuer_url | html %]"
                     placeholder="https://opac.your-library.org/api/v1/contrib/oauthprovider">
              <div class="hint">
                [% T.cfg_issuer_hint_pre | $raw %]<code>[% settings.issuer_url | html %]/.well-known/openid-configuration</code>[% T.cfg_issuer_hint_post | $raw %]
              </div>
            </li>
            <li>
              <label for="access_token_ttl_seconds">[% T.cfg_access_ttl_label | $raw %]</label>
              <input type="number" id="access_token_ttl_seconds" name="access_token_ttl_seconds" min="1" size="10"
                     value="[% settings.access_token_ttl_seconds | html %]">
              <div class="hint">[% T.cfg_access_ttl_hint | $raw %]</div>
            </li>
            <li>
              <label for="refresh_token_ttl_seconds">[% T.cfg_refresh_ttl_label | $raw %]</label>
              <input type="number" id="refresh_token_ttl_seconds" name="refresh_token_ttl_seconds" min="1" size="10"
                     value="[% settings.refresh_token_ttl_seconds | html %]">
              <div class="hint">[% T.cfg_refresh_ttl_hint | $raw %]</div>
            </li>
          </ol>
        </fieldset>
        <fieldset class="action">
          <input type="submit" value="[% T.common_save | $raw %]" class="btn btn-primary">
        </fieldset>
      </form>

      <h2>[% T.cfg_templates_heading | $raw %]</h2>
      <p class="hint">[% T.cfg_templates_hint | $raw %]</p>
      <table class="table">
        <thead>
          <tr>
            <th>[% T.cfg_templates_th_page | $raw %]</th>
            <th>[% T.cfg_templates_th_status | $raw %]</th>
            <th>[% T.cfg_templates_th_actions | $raw %]</th>
          </tr>
        </thead>
        <tbody>
          [% FOREACH tpl IN template_customization %]
            [% SET label_key = 'cfg_template_label_' _ tpl.name %]
            <tr>
              <td>[% T.$label_key | $raw %]</td>
              <td>[% IF tpl.is_custom %][% T.cfg_template_status_custom | $raw %][% ELSE %]<em>[% T.cfg_template_status_default | $raw %]</em>[% END %]</td>
              <td>
                <a href="#" class="btn btn-default btn-xs" data-toggle="modal" data-target="#oauthprovider-template-modal-[% tpl.name | html %]">
                  [% T.cfg_template_edit | $raw %]
                </a>
              </td>
            </tr>
          [% END %]
        </tbody>
      </table>

      [% FOREACH tpl IN template_customization %]
        [% SET label_key = 'cfg_template_label_' _ tpl.name %]
        [% SET hint_key  = 'cfg_template_hint_' _ tpl.name %]
        <div class="modal" id="oauthprovider-template-modal-[% tpl.name | html %]" tabindex="-1" role="dialog">
          <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
              <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title">[% T.$label_key | $raw %]</h4>
              </div>
              <form method="post">
                <input type="hidden" name="class" value="[% plugin_class | html %]">
                <input type="hidden" name="method" value="configure">
                <input type="hidden" name="action" value="save_custom_template">
                <input type="hidden" name="template_name" value="[% tpl.name | html %]">
                <div class="modal-body">
                  <div class="hint">[% T.$hint_key | $raw %]</div>
                  <textarea name="template_html" rows="28" style="width:100%;box-sizing:border-box;font-family:monospace;font-size:0.85em;">[% tpl.source | html %]</textarea>
                </div>
                <div class="modal-footer">
                  [% IF tpl.is_custom %]
                    <button type="submit" form="oauthprovider-template-reset-[% tpl.name | html %]" class="btn btn-default"
                            onclick="return confirm('[% T.cfg_template_confirm_reset | html %]');">
                      [% T.cfg_template_reset | $raw %]
                    </button>
                  [% END %]
                  <button type="button" class="btn btn-default" data-dismiss="modal">[% T.cfg_cancel | $raw %]</button>
                  <button type="submit" class="btn btn-primary">[% T.common_save | $raw %]</button>
                </div>
              </form>
              [% IF tpl.is_custom %]
                <form method="post" id="oauthprovider-template-reset-[% tpl.name | html %]" style="display:none">
                  <input type="hidden" name="class" value="[% plugin_class | html %]">
                  <input type="hidden" name="method" value="configure">
                  <input type="hidden" name="action" value="reset_custom_template">
                  <input type="hidden" name="template_name" value="[% tpl.name | html %]">
                </form>
              [% END %]
            </div>
          </div>
        </div>
      [% END %]

      <h2>[% T.cfg_apps_heading | $raw %]</h2>

      [% IF new_secret %]
        <div class="dialog message">
          <strong>[% T.cfg_new_secret_title | $raw %]</strong> [% T.cfg_new_secret_body | $raw %]
          <fieldset class="rows">
            <ol>
              <li><label>[% T.cfg_client_id_label | $raw %]</label> <code>[% new_client_id | html %]</code></li>
              <li><label>[% T.cfg_client_secret_label | $raw %]</label> <code>[% new_secret | html %]</code></li>
            </ol>
          </fieldset>
        </div>
      [% END %]

      [% IF clients.size == 0 %]
        <p>[% T.cfg_no_apps | $raw %]</p>
      [% ELSE %]
        <table class="table">
          <thead>
            <tr>
              <th>[% T.cfg_th_name | $raw %]</th>
              <th>[% T.cfg_th_client_id | $raw %]</th>
              <th>[% T.cfg_th_redirect_uris | $raw %]</th>
              <th>[% T.cfg_th_claims | $raw %]</th>
              <th>[% T.cfg_th_categories | $raw %]</th>
              <th>[% T.cfg_th_consent_mode | $raw %]</th>
              <th>[% T.cfg_th_status | $raw %]</th>
              <th>[% T.cfg_th_actions | $raw %]</th>
            </tr>
          </thead>
          <tbody>
            [% FOREACH client IN clients %]
              <tr>
                <td>[% client.client_name | html %]</td>
                <td><code>[% client.client_id | html %]</code></td>
                <td>
                  [% FOREACH uri IN client.redirect_uris %]
                    <div>[% uri | html %]</div>
                  [% END %]
                </td>
                <td>
                  [% IF client.allowed_claims.size == 0 %]
                    <em>[% T.cfg_only_userid | $raw %]</em>
                  [% ELSE %]
                    [% FOREACH entry IN client.allowed_claims %]
                      <div>[% entry.claim_name | html %]</div>
                    [% END %]
                  [% END %]
                </td>
                <td>
                  [% IF client.allowed_categories.size == 0 && client.denied_categories.size == 0 %]
                    <em>[% T.cfg_no_category_restriction | $raw %]</em>
                  [% ELSE %]
                    [% IF client.allowed_categories.size %]<div>[% T.cfg_allowed_categories_label | $raw %] [% client.allowed_categories.join(', ') | html %]</div>[% END %]
                    [% IF client.denied_categories.size %]<div>[% T.cfg_denied_categories_label | $raw %] [% client.denied_categories.join(', ') | html %]</div>[% END %]
                  [% END %]
                </td>
                <td>
                  [% SET consent_mode_label_key = 'cfg_consent_mode_' _ client.consent_mode %]
                  [% T.$consent_mode_label_key | $raw %]
                </td>
                <td>[% IF client.is_active %][% T.cfg_status_active | $raw %][% ELSE %]<em>[% T.cfg_status_inactive | $raw %]</em>[% END %]</td>
                <td>
                  <a class="btn btn-default btn-xs"
                     href="/cgi-bin/koha/plugins/run.pl?class=[% class_name | html %]&amp;method=configure&amp;edit=[% client.id | html %]">
                    [% T.cfg_edit | $raw %]
                  </a>
                  <form method="post" style="display:inline" onsubmit="return confirm('[% T.cfg_confirm_regenerate | html %]');">
                    <input type="hidden" name="class" value="[% plugin_class | html %]">
                    <input type="hidden" name="method" value="configure">
                    <input type="hidden" name="action" value="regenerate_secret">
                    <input type="hidden" name="id" value="[% client.id | html %]">
                    <button type="submit" class="btn btn-default btn-xs">[% T.cfg_regenerate | $raw %]</button>
                  </form>
                  <form method="post" style="display:inline" onsubmit="return confirm('[% T.cfg_confirm_delete | html %]');">
                    <input type="hidden" name="class" value="[% plugin_class | html %]">
                    <input type="hidden" name="method" value="configure">
                    <input type="hidden" name="action" value="delete">
                    <input type="hidden" name="id" value="[% client.id | html %]">
                    <button type="submit" class="btn btn-default btn-xs">[% T.cfg_delete | $raw %]</button>
                  </form>
                </td>
              </tr>
            [% END %]
          </tbody>
        </table>
      [% END %]

      [% IF edit_client %]
        <h2>[% T.cfg_edit_heading_pre | $raw %][% edit_client.client_name | html %]</h2>
        <form method="post">
          <input type="hidden" name="class" value="[% plugin_class | html %]">
          <input type="hidden" name="method" value="configure">
          <input type="hidden" name="action" value="update">
          <input type="hidden" name="id" value="[% edit_client.id | html %]">
          <fieldset class="rows">
            <ol>
              <li>
                <label for="client_name">[% T.cfg_name_label | $raw %]</label>
                <input type="text" id="client_name" name="client_name" size="40" value="[% edit_client.client_name | html %]" required>
              </li>
              <li>
                <label for="is_active">[% T.cfg_active_label | $raw %]</label>
                <input type="checkbox" id="is_active" name="is_active" value="1" [% IF edit_client.is_active %]checked[% END %]>
              </li>
              <li>
                <label for="consent_mode">[% T.cfg_consent_mode_label | $raw %]</label>
                <select id="consent_mode" name="consent_mode">
                  [% FOREACH mode IN consent_modes %]
                    [% SET consent_mode_label_key = 'cfg_consent_mode_' _ mode %]
                    <option value="[% mode | html %]" [% IF edit_client.consent_mode == mode %]selected="selected"[% END %]>
                      [% T.$consent_mode_label_key | $raw %]
                    </option>
                  [% END %]
                </select>
                <div class="hint">[% T.cfg_consent_mode_hint | $raw %]</div>
              </li>
              <li>
                <label for="access_token_ttl_seconds">[% T.cfg_client_access_ttl_label | $raw %]</label>
                <input type="number" id="access_token_ttl_seconds" name="access_token_ttl_seconds" min="1" size="10"
                       value="[% edit_client.access_token_ttl_seconds | html %]"
                       placeholder="[% settings.access_token_ttl_seconds | html %]">
                <div class="hint">[% T.cfg_client_ttl_hint | $raw %]</div>
              </li>
              <li>
                <label for="refresh_token_ttl_seconds">[% T.cfg_client_refresh_ttl_label | $raw %]</label>
                <input type="number" id="refresh_token_ttl_seconds" name="refresh_token_ttl_seconds" min="1" size="10"
                       value="[% edit_client.refresh_token_ttl_seconds | html %]"
                       placeholder="[% settings.refresh_token_ttl_seconds | html %]">
                <div class="hint">[% T.cfg_client_ttl_hint | $raw %]</div>
              </li>
              <li>
                <label for="redirect_uris">[% T.cfg_redirect_uris_label | $raw %]</label>
                <textarea id="redirect_uris" name="redirect_uris" rows="4" cols="60">[% edit_client.redirect_uris.join("\n") | html %]</textarea>
              </li>
              <li>
                <label>[% T.cfg_claims_label | $raw %]</label>
                <div style="margin-left:21rem;max-width:60rem">
                  [% PROCESS claims_config_widget claims = edit_client.allowed_claims %]
                </div>
              </li>
              <li>
                <label for="allowed_categories">[% T.cfg_allowed_categories_label | $raw %]</label>
                <div class="hint">[% T.cfg_allowed_categories_hint | $raw %]</div>
                <div style="margin-left:21rem;max-width:40rem">
                  <select id="allowed_categories" name="allowed_categories" multiple="multiple" class="select2" style="width:100%">
                    [% FOREACH cat IN patron_categories %]
                      <option value="[% cat.categorycode | html %]"
                        [% IF edit_client.allowed_categories.grep('^' _ cat.categorycode _ '$').size %]selected="selected"[% END %]>
                        [% cat.description | html %] ([% cat.categorycode | html %])
                      </option>
                    [% END %]
                  </select>
                </div>
              </li>
              <li>
                <label for="denied_categories">[% T.cfg_denied_categories_label | $raw %]</label>
                <div class="hint">[% T.cfg_denied_categories_hint | $raw %]</div>
                <div style="margin-left:21rem;max-width:40rem">
                  <select id="denied_categories" name="denied_categories" multiple="multiple" class="select2" style="width:100%">
                    [% FOREACH cat IN patron_categories %]
                      <option value="[% cat.categorycode | html %]"
                        [% IF edit_client.denied_categories.grep('^' _ cat.categorycode _ '$').size %]selected="selected"[% END %]>
                        [% cat.description | html %] ([% cat.categorycode | html %])
                      </option>
                    [% END %]
                  </select>
                </div>
              </li>
            </ol>
          </fieldset>
          <fieldset class="action">
            <input type="submit" value="[% T.common_save | $raw %]" class="btn btn-primary">
            <a class="btn btn-default" href="/cgi-bin/koha/plugins/run.pl?class=[% class_name | html %]&amp;method=configure">[% T.cfg_cancel | $raw %]</a>
          </fieldset>
        </form>
      [% ELSE %]
        <h2>[% T.cfg_add_heading | $raw %]</h2>
        <form method="post">
          <input type="hidden" name="class" value="[% plugin_class | html %]">
          <input type="hidden" name="method" value="configure">
          <input type="hidden" name="action" value="create">
          <fieldset class="rows">
            <ol>
              <li>
                <label for="client_name">[% T.cfg_name_label | $raw %]</label>
                <input type="text" id="client_name" name="client_name" size="40" required>
              </li>
              <li>
                <label for="consent_mode">[% T.cfg_consent_mode_label | $raw %]</label>
                <select id="consent_mode" name="consent_mode">
                  [% FOREACH mode IN consent_modes %]
                    [% SET consent_mode_label_key = 'cfg_consent_mode_' _ mode %]
                    <option value="[% mode | html %]">
                      [% T.$consent_mode_label_key | $raw %]
                    </option>
                  [% END %]
                </select>
                <div class="hint">[% T.cfg_consent_mode_hint | $raw %]</div>
              </li>
              <li>
                <label for="access_token_ttl_seconds">[% T.cfg_client_access_ttl_label | $raw %]</label>
                <input type="number" id="access_token_ttl_seconds" name="access_token_ttl_seconds" min="1" size="10"
                       placeholder="[% settings.access_token_ttl_seconds | html %]">
                <div class="hint">[% T.cfg_client_ttl_hint | $raw %]</div>
              </li>
              <li>
                <label for="refresh_token_ttl_seconds">[% T.cfg_client_refresh_ttl_label | $raw %]</label>
                <input type="number" id="refresh_token_ttl_seconds" name="refresh_token_ttl_seconds" min="1" size="10"
                       placeholder="[% settings.refresh_token_ttl_seconds | html %]">
                <div class="hint">[% T.cfg_client_ttl_hint | $raw %]</div>
              </li>
              <li>
                <label for="redirect_uris">[% T.cfg_redirect_uris_label | $raw %]</label>
                <textarea id="redirect_uris" name="redirect_uris" rows="4" cols="60" placeholder="https://app.example.org/oauth/callback"></textarea>
              </li>
              <li>
                <label>[% T.cfg_claims_label | $raw %]</label>
                <div style="margin-left:21rem;max-width:60rem">
                  [% PROCESS claims_config_widget claims = [] %]
                </div>
              </li>
              <li>
                <label for="allowed_categories">[% T.cfg_allowed_categories_label | $raw %]</label>
                <div class="hint">[% T.cfg_allowed_categories_hint | $raw %]</div>
                <div style="margin-left:21rem;max-width:40rem">
                  <select id="allowed_categories" name="allowed_categories" multiple="multiple" class="select2" style="width:100%">
                    [% FOREACH cat IN patron_categories %]
                      <option value="[% cat.categorycode | html %]">
                        [% cat.description | html %] ([% cat.categorycode | html %])
                      </option>
                    [% END %]
                  </select>
                </div>
              </li>
              <li>
                <label for="denied_categories">[% T.cfg_denied_categories_label | $raw %]</label>
                <div class="hint">[% T.cfg_denied_categories_hint | $raw %]</div>
                <div style="margin-left:21rem;max-width:40rem">
                  <select id="denied_categories" name="denied_categories" multiple="multiple" class="select2" style="width:100%">
                    [% FOREACH cat IN patron_categories %]
                      <option value="[% cat.categorycode | html %]">
                        [% cat.description | html %] ([% cat.categorycode | html %])
                      </option>
                    [% END %]
                  </select>
                </div>
              </li>
            </ol>
          </fieldset>
          <fieldset class="action">
            <input type="submit" value="[% T.cfg_create_submit | $raw %]" class="btn btn-primary">
          </fieldset>
        </form>
      [% END %]

    </div>
  </div>
</div>

<script>
    $(document).ready(function () {
        var $widget = $('.oauthprovider-claims-widget');
        if ( !$widget.length ) { return; }

        var $table       = $widget.find('.oauthprovider-claims-table tbody');
        var $dupError    = $widget.find('.claims-duplicate-error');
        var $modal       = $('#oauthprovider-claim-modal');
        var $modalType    = $('#oauthprovider-modal-type');
        var $modalField   = $('#oauthprovider-modal-field-source');
        var $modalAttr    = $('#oauthprovider-modal-attribute-source');
        var $modalStatic  = $('#oauthprovider-modal-static-value');
        var $modalName    = $('#oauthprovider-modal-claim-name');
        var $modalError   = $('#oauthprovider-claim-modal .oauthprovider-modal-error');
        var $modalConfirm = $('#oauthprovider-modal-confirm');

        // Populate the two live selects from their hidden "template" selects
        // (rendered server-side with the correct translated labels/attribute
        // descriptions) - done once, they don't change during this page view.
        $modalField.html( $('#oauthprovider-field-catalog-template').html() );
        $modalAttr.html( $('#oauthprovider-attribute-catalog-template').html() );

        function currentClaimNames() {
            var names = [];
            $table.find('.claim-name-input').each(function () {
                var v = $.trim( $(this).val() );
                if ( v.length ) { names.push(v); }
            });
            return names;
        }

        function refreshDuplicateState() {
            var seen = {};
            var duplicates = {};
            $table.find('.claim-name-input').each(function () {
                var v = $.trim( $(this).val() );
                if ( !v.length ) { return; }
                if ( seen[v] ) { duplicates[v] = true; }
                seen[v] = true;
            });

            var anyDuplicate = false;
            $table.find('.claim-name-input').each(function () {
                var v = $.trim( $(this).val() );
                if ( v.length && duplicates[v] ) {
                    $(this).css('border-color', '#a12622');
                    anyDuplicate = true;
                } else {
                    $(this).css('border-color', '');
                }
            });

            $dupError.toggle(anyDuplicate);
            $widget.closest('form').find('[type=submit]').prop('disabled', anyDuplicate);
            return anyDuplicate;
        }

        function updateModalRowVisibility() {
            var type = $modalType.val();
            $('.oauthprovider-modal-field-row').toggle(type === 'field');
            $('.oauthprovider-modal-attribute-row').toggle(type === 'attribute');
            $('.oauthprovider-modal-static-row').toggle(type === 'static');
        }

        function defaultClaimNameForModal() {
            var type = $modalType.val();
            if ( type === 'field' ) { return $modalField.val() || ''; }
            if ( type === 'attribute' ) { return $modalAttr.val() || ''; }
            return '';
        }

        $modalType.on('change', function () {
            updateModalRowVisibility();
            $modalName.val( defaultClaimNameForModal() );
        });
        $modalField.on('change', function () {
            if ( $modalType.val() === 'field' ) { $modalName.val( $modalField.val() || '' ); }
        });
        $modalAttr.on('change', function () {
            if ( $modalType.val() === 'attribute' ) { $modalName.val( $modalAttr.val() || '' ); }
        });

        $modal.on('show.bs.modal', function () {
            $modalType.val('field');
            updateModalRowVisibility();
            $modalStatic.val('');
            $modalName.val( defaultClaimNameForModal() );
            $modalError.hide().text('');
        });

        function sourceDisplayForModal() {
            var type = $modalType.val();
            if ( type === 'field' ) { return $modalField.find('option:selected').text(); }
            if ( type === 'attribute' ) { return $modalAttr.find('option:selected').text(); }
            return $widget.data('static-label');
        }

        $modalConfirm.on('click', function () {
            var type      = $modalType.val();
            var source    = type === 'field' ? $modalField.val() : ( type === 'attribute' ? $modalAttr.val() : '' );
            var value     = type === 'static' ? $modalStatic.val() : '';
            var claimName = $.trim( $modalName.val() );

            if ( !/^[A-Za-z_][A-Za-z0-9_]*$/.test(claimName) ) {
                $modalError.text( $widget.data('name-hint') ).show();
                return;
            }
            if ( claimName === 'userid' || claimName === 'sub'
                 || currentClaimNames().indexOf(claimName) !== -1 ) {
                $modalError.text( $widget.data('duplicate-error') ).show();
                return;
            }

            var $row = $(
                '<tr class="claim-row">' +
                    '<td class="claim-source-display"></td>' +
                    '<td>' +
                        '<input type="hidden" name="claim_type">' +
                        '<input type="hidden" name="claim_source">' +
                        '<input type="text" name="claim_name" class="claim-name-input" required pattern="[A-Za-z_][A-Za-z0-9_]*">' +
                    '</td>' +
                    '<td><input type="text" name="claim_value" class="claim-value-input"></td>' +
                    '<td><button type="button" class="btn btn-default btn-xs claims-remove-row"></button></td>' +
                '</tr>'
            );
            $row.find('.claims-remove-row').text( $widget.data('remove-label') );
            $row.find('.claim-source-display').text( sourceDisplayForModal() );
            $row.find('input[name=claim_type]').val(type);
            $row.find('input[name=claim_source]').val(source);
            $row.find('input[name=claim_name]').val(claimName);
            var $valueInput = $row.find('input[name=claim_value]').val(value);
            if ( type !== 'static' ) { $valueInput.css('visibility', 'hidden'); }

            $table.append($row);
            refreshDuplicateState();
            $modal.modal('hide');
        });

        $table.on('click', '.claims-remove-row', function () {
            $(this).closest('tr').remove();
            refreshDuplicateState();
        });

        $table.on('input change', '.claim-name-input', function () {
            refreshDuplicateState();
        });

        $widget.closest('form').on('submit', function (e) {
            if ( refreshDuplicateState() ) { e.preventDefault(); }
        });

        updateModalRowVisibility();
        refreshDuplicateState();
    });
</script>

[% INCLUDE 'select2.inc' %]
[% INCLUDE 'intranet-bottom.inc' %]
